#!/bin/sh
set -e

# Nothing to provision: tdcn recovers this device's key/certificate itself
# at every startup, and defaults its friendly_name to the hostname on its
# own when /etc/tdcn/config.toml doesn't set one.

case "$1" in
    configure)
        # This package ships /etc/configserver/conf.d/tidal-connect.json, which
        # is what grants the Web UI permission to start and stop this player.
        # config-server reads conf.d once, on first use, and caches the result
        # for the life of the process -- so a drop-in installed underneath a
        # running config-server is never seen. The player then appears in the
        # UI with its controls inert, because its permission level falls back
        # to "status" alone, which is indistinguishable from a broken player.
        #
        # try-restart, so this does nothing when config-server is not running,
        # and the /run/systemd/system guard keeps it out of image builds. Never
        # allowed to fail: the UI being stale is not worth a failed install.
        if [ -d /run/systemd/system ]; then
            systemctl try-restart config-server.service >/dev/null 2>&1 || true
        fi

        # prerm stops tdcn on upgrade, and dh_installsystemduser emits no
        # restart to match -- for system units dh_installsystemd restarts
        # after an upgrade, but its user-unit counterpart does nothing. So
        # without this an upgrade leaves the player stopped, with the Web UI
        # showing it inactive and no indication why.
        #
        # Only start it if it is enabled: a user who switched the player off
        # must not have it switched back on by an upgrade. Reached the same
        # way as in prerm -- the audio user's own manager via systemd-run --
        # and best effort throughout.
        if [ -d /run/systemd/system ]; then
            HB_USER=""
            if [ -f /etc/hifiberry.user ]; then
                HB_USER=$(grep -vE '^[[:space:]]*#|^[[:space:]]*$' /etc/hifiberry.user | head -1 | tr -d '[:space:]')
            fi
            if [ -n "$HB_USER" ] && getent passwd "$HB_USER" >/dev/null 2>&1; then
                HB_UID=$(id -u "$HB_USER" 2>/dev/null)
                if [ -n "$HB_UID" ] && [ -d "/run/user/$HB_UID" ]; then
                    systemd-run --uid "$HB_UID" --setenv XDG_RUNTIME_DIR="/run/user/$HB_UID" \
                        --pipe --wait --quiet --collect \
                        sh -c 'systemctl --user daemon-reload >/dev/null 2>&1; \
                               if systemctl --user is-enabled tdcn.service >/dev/null 2>&1; then \
                                   systemctl --user start tdcn.service >/dev/null 2>&1; \
                               fi' >/dev/null 2>&1 || true
                fi
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0
