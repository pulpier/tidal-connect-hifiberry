#!/bin/sh
set -e

case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop tidal-watchdog.service tidal-bridge.service \
                     tidal-connect.service tidal-connect-build.service \
                     >/dev/null 2>&1 || true
    fi
    ;;
esac

#DEBHELPER#

exit 0
