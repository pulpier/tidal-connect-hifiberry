# Docker build context + runtime scripts
Docker opt/tidal-connect/
entrypoint.sh opt/tidal-connect/
tidal-bridge.sh opt/tidal-connect/
tidal-watchdog.sh opt/tidal-connect/
volume-bridge.sh opt/tidal-connect/
wait-for-avahi.sh opt/tidal-connect/
wait-for-container.sh opt/tidal-connect/
wait-for-mdns-clear.sh opt/tidal-connect/

# systemd units
tidal-connect.service lib/systemd/system/
tidal-bridge.service lib/systemd/system/
tidal-watchdog.service lib/systemd/system/
tidal-connect-build.service lib/systemd/system/

# Web UI player registry + icon
debian/extras/etc/hifiberry/players.d/tidal.json etc/hifiberry/players.d/
debian/extras/etc/hifiberry/players.d/icons/tidal.svg etc/hifiberry/players.d/icons/

# AudioControl (ACR) metadata registration
debian/extras/etc/audiocontrol/players.d/tidal.json etc/audiocontrol/players.d/

# config-server permission to control the service from the Web UI
debian/extras/etc/configserver/conf.d/tidal-connect.json etc/configserver/conf.d/
