[Unit]
Description=Tidal Connect
After=docker.service avahi-daemon.service tidal-connect-build.service
Requires=docker.service tidal-connect-build.service
Wants=avahi-daemon.service
# Only start once the container image has actually been built. Starting before
# then is a skipped (not failed) start, so the Web UI can enable this service
# immediately after install and it simply waits for the build to finish.
ConditionPathExists=/opt/tidal-connect/.build-stamp

[Service]
Type=simple
WorkingDirectory=/opt/tidal-connect
ExecStartPre=/usr/bin/docker compose down --remove-orphans
ExecStart=/usr/bin/docker compose up --no-build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=45
TimeoutStopSec=15
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
