[Unit]
Description=Build the Tidal Connect container image
Documentation=https://github.com/pulpier/tidal-connect-hifiberry
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Skip once the image has been built; the stamp is removed on package upgrade.
ConditionPathExists=!/opt/tidal-connect/.build-stamp

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/tidal-connect
# The build pulls the raspbian/stretch base and legacy libs from the network
# (~2 min). A failure here is retryable with `systemctl restart
# tidal-connect-build` and never corrupts package state.
ExecStart=/usr/bin/docker build -t hifiberry-tidal-connect:latest -f Docker/Dockerfile .
ExecStartPost=/usr/bin/touch /opt/tidal-connect/.build-stamp
# Once the image exists, bring up the endpoint, metadata bridge, and watchdog.
# --no-block is required: tidal-connect.service has Requires=/After= this unit,
# so a blocking start would wait for this unit to finish activating while this
# ExecStartPost is itself part of that activation — a deadlock. Enqueue the
# start and let it run once this unit becomes active.
ExecStartPost=/usr/bin/systemctl start --no-block tidal-connect.service tidal-bridge.service tidal-watchdog.service
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
